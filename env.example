# Copy to `.env` for local development (do not commit `.env`).
# In Netlify, set these in Site settings → Environment variables.

# Public (exposed to the browser)
NEXT_PUBLIC_TEBEX_TOKEN=
NEXT_PUBLIC_IS_DEMO=false

# Server-only
SERVER_SECRET=
ADMIN_PASSWORD=

# Recommended for serverless hosts (Netlify)
USING_SERVERLESS=true
