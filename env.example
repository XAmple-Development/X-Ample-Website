## Tebex (server-side)
# Token used in: https://headless.tebex.io/api/accounts/{token}/...
TEBEX_WEBSTORE_TOKEN=

# HTTP Basic auth username/password for Tebex Headless API
TEBEX_PUBLIC_TOKEN=
TEBEX_PRIVATE_KEY=

## Site
# Used to build Tebex basket complete/cancel URLs
# Example: https://x-ampledevelopment.co.uk
SITE_URL=https://x-ampledevelopment.co.uk

# Optional (public) base URL used by some helpers
NEXT_PUBLIC_SITE_URL=https://x-ampledevelopment.co.uk

## Analytics (optional)
# If set, loads Plausible script and enables custom event tracking.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: used to show “Edit docs” links (point to your repo edit path)
# Example: https://github.com/<owner>/<repo>/edit/<branch>
NEXT_PUBLIC_GITHUB_EDIT_BASE=

## Dashboard (Supabase + sessions)
SUPABASE_URL=
# Server-only! Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign the HttpOnly session cookie (use a long random value)
SESSION_SECRET=

# Tebex webhook secret (set in Tebex control panel for your webhook endpoint)
TEBEX_WEBHOOK_SECRET=

# Tebex Plugin API (fallback purchases sync)
# Get this from Tebex → Integrations → Game Servers → your server → Secret
TEBEX_PLUGIN_SECRET=

# Comma-separated Tebex customer ids that can access /dashboard/admin
# Example: 12345,67890
ADMIN_ALLOWLIST=

## Decap CMS GitHub OAuth (Netlify Functions)
OAUTH_PROVIDER=github
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# For private repos, you typically need: repo. For public repos, "public_repo" may be enough.
OAUTH_SCOPES=repo,user:email
COMPLETE_URL=https://x-ampledevelopment.co.uk/.netlify/functions/oauth-complete
# Domain without protocol (used for origin checks)
ORIGIN=x-ampledevelopment.co.uk

# If your OAuth library expects a specific key, set this too:
OAUTH_ORIGIN=x-ampledevelopment.co.uk

