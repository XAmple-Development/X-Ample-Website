## Site
# Canonical site URL (used for SEO, sitemap, JSON-LD)
SITE_URL=https://x-ampledevelopment.co.uk
NEXT_PUBLIC_SITE_URL=https://x-ampledevelopment.co.uk

## Contact form (email via Resend)
# Get your API key at https://resend.com
RESEND_API_KEY=
# Inbox that receives contact form submissions (default: info@x-ampledevelopment.co.uk)
CONTACT_EMAIL=info@x-ampledevelopment.co.uk
# Optional: "Display Name <verified@yourdomain.com>" (must be a verified domain in Resend)
# RESEND_FROM=Contact Form <contact@x-ampledevelopment.co.uk>

## Conversion (optional)
# Calendly or similar booking link — shows "Book a call" on Contact and homepage CTA
NEXT_PUBLIC_CALENDLY_URL=
# Discord server ID for embed widget on Support page (Developer Portal → Server Widget)
NEXT_PUBLIC_DISCORD_GUILD_ID=

## Analytics (optional)
# If set, loads Plausible script and enables custom event tracking.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: used to show “Edit docs” links (point to your repo edit path)
# NEXT_PUBLIC_GITHUB_EDIT_BASE=

## Supabase (vacancies, team, portfolio, newsletter)
SUPABASE_URL=
# Server-only! Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

## Content admin
# Password to access /admin/vacancies, /admin/portfolio, /admin/team, etc. Min 8 characters.
CONTENT_ADMIN_SECRET=

## Decap CMS GitHub OAuth (Netlify Functions)
OAUTH_PROVIDER=github
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES=repo,user:email
COMPLETE_URL=https://x-ampledevelopment.co.uk/.netlify/functions/oauth-complete
ORIGIN=x-ampledevelopment.co.uk
OAUTH_ORIGIN=x-ampledevelopment.co.uk
# Decap CMS panel URL after GitHub OAuth (default /cms)
ADMIN_PANEL_URL=/cms
