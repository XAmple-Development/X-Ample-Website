## Tebex (server-side)
# Token used in: https://headless.tebex.io/api/accounts/{token}/...
TEBEX_WEBSTORE_TOKEN=

# HTTP Basic auth username/password for Tebex Headless API
TEBEX_PUBLIC_TOKEN=
TEBEX_PRIVATE_KEY=

## Site
# Used to build Tebex basket complete/cancel URLs
# Example: https://x-ampledevelopment.co.uk
SITE_URL=https://x-ampledevelopment.co.uk

## Decap CMS GitHub OAuth (Netlify Functions)
OAUTH_PROVIDER=github
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# For private repos, you typically need: repo. For public repos, "public_repo" may be enough.
OAUTH_SCOPES=repo,user:email
COMPLETE_URL=https://x-ampledevelopment.co.uk/.netlify/functions/oauth-complete
# Domain without protocol (used for origin checks)
ORIGIN=x-ampledevelopment.co.uk

# If your OAuth library expects a specific key, set this too:
OAUTH_ORIGIN=x-ampledevelopment.co.uk

